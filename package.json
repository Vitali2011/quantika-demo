{
  "name": "bootstrap-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest --forceExit",
    "test:regression": "jest --testPathPattern=tests/regression --forceExit",
    "test:regression:prod": "jest --testPathPattern='tests/regression/test-tc' --silent",
    "test:smoke": "playwright test --config=__tests__/e2e/playwright.config.smoke.ts",
    "test:smoke:prod": "SMOKE_BASE_URL=https://demo.quantika.org playwright test --config=__tests__/e2e/playwright.config.smoke.ts smoke/tier1-health.spec.ts",
    "test:smoke:tier1": "playwright test --config=__tests__/e2e/playwright.config.smoke.ts smoke/tier1-health.spec.ts",
    "test:e2e": "playwright test",
    "build:extension": "cd extensions/gmail && npm install --no-audit --no-fund --silent && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@sentry/nextjs": "^10.50.0",
    "@types/sanitize-html": "^2.16.1",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuzzysort": "^3.1.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.4",
    "openai": "^6.33.0",
    "p-limit": "^7.3.0",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "posthog-js": "^1.372.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanitize-html": "^2.17.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.37",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.12",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "^10.5.0",
    "postcss": "^8.5.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "bash -c 'npx tsc --noEmit'"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
