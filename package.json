{
  "name": "bootstrap-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "golden": "jest --testPathPatterns 'lib/matching/__tests__/golden-set/.*\\.test\\.ts'",
    "test:regression": "jest --testPathPatterns tests/regression --testPathIgnorePatterns '/node_modules/' --forceExit",
    "test:regression:prod": "jest --testPathPatterns 'tests/regression/test-tc' --testPathIgnorePatterns '/node_modules/' --silent",
    "test:smoke": "playwright test --config=__tests__/e2e/playwright.config.smoke.ts",
    "test:suite": "playwright test --config=__tests__/e2e/playwright.config.suite.ts",
    "test:suite:prod": "SUITE_BASE_URL=https://demo.quantika.org DEMO_AUTH_ENABLED=true playwright test --config=__tests__/e2e/playwright.config.suite.ts",
    "test:smoke:prod": "SMOKE_BASE_URL=https://demo.quantika.org playwright test --config=__tests__/e2e/playwright.config.smoke.ts smoke/tier1-health.spec.ts",
    "test:smoke:tier1": "playwright test --config=__tests__/e2e/playwright.config.smoke.ts smoke/tier1-health.spec.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "analyze": "ANALYZE=true next build --webpack",
    "build:extension": "cd extensions/gmail && npm install --no-audit --no-fund --silent && npm run build",
    "knowledge:status": "npx tsx scripts/knowledge/status.ts",
    "knowledge:refresh": "npx tsx scripts/knowledge/refresh.ts",
    "knowledge:imsbc": "npx tsx scripts/knowledge-imsbc-embed.ts",
    "knowledge:jwc-yaml": "npx tsx scripts/knowledge-jwc-yaml-seed.ts",
    "knowledge:igc": "npx tsx scripts/knowledge-igc-embed.ts",
    "knowledge:unlocode": "npx tsx scripts/knowledge-unlocode-seed.ts",
    "knowledge:baltic": "npx tsx scripts/knowledge-baltic-seed.ts",
    "bake-off": "tsx scripts/wave-gamma-bake-off/cli.ts",
    "bake-off:redecide": "tsx scripts/wave-gamma-bake-off/redecide.ts",
    "bake-off:validate-baseline": "tsx scripts/wave-gamma-bake-off/validate-baseline.ts",
    "bake-off:ground-truth": "tsx scripts/wave-gamma-bake-off/build-ground-truth.ts",
    "build-reference": "tsx scripts/wave-gamma-bake-off/build-reference.ts",
    "setup:gmail-oauth": "tsx scripts/setup-gmail-oauth.ts",
    "import:emails": "tsx scripts/import-gmail-emails.ts",
    "build:corpus": "tsx scripts/build-corpus.ts",
    "smoke:genai-v2": "npx tsx scripts/smoke/genai-v2.ts",
    "sync:corpus:vps": "bash scripts/sync-corpus-vps.sh",
    "corpus:extract": "tsx scripts/extract-corpus-cases.ts",
    "prepare": "husky",
    "build:sample-data": "npx tsx scripts/build-sample-data.ts",
    "seed:parse": "AI_PROVIDER=claude-cli tsx scripts/demo-seed/parse-llm-direct.ts",
    "seed:reconcile": "AI_PROVIDER=claude-cli tsx scripts/demo-seed/reconcile.ts",
    "seed:build": "tsx scripts/demo-seed/build.ts",
    "seed:regen": "tsx scripts/demo-seed/regenerate-matches.ts",
    "seed:validate": "tsx scripts/demo-seed/validators.ts",
    "seed:all": "AI_PROVIDER=claude-cli tsx scripts/demo-seed/seed-all.ts",
    "quote:workshop": "tsx scripts/quote-workshop/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.31.0",
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1073.0",
    "@base-ui/react": "^1.6.0",
    "@google-cloud/aiplatform": "^6.8.1",
    "@google-cloud/discoveryengine": "^2.7.0",
    "@google/genai": "^2.9.0",
    "@sentry/nextjs": "^10.59.0",
    "@types/sanitize-html": "^2.16.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuzzysort": "^3.1.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "openai": "^6.44.0",
    "p-limit": "^7.3.0",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "posthog-js": "^1.391.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.14.0",
    "sanitize-html": "^2.17.5",
    "searoute-ts": "^2.0.0",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^10.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "bash -c 'NODE_OPTIONS=--max-old-space-size=4096 npx tsc --noEmit'"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
