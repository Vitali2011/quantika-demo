GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
CLIPROXY_API_KEY=cliproxy-key-1
CLIPROXY_BASE_URL=http://localhost:8317/v1
AI_MODEL_HEAVY=gpt-5.5
AI_MODEL_LIGHT=gpt-5.3-codex
NEXT_PUBLIC_APP_URL=https://demo.quantika.org
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Rate-limit client-IP source for the login/admin brute-force throttles.
# REQUIRED in prod for per-IP limiting. If unset, the limiter FAIL-CLOSES to one
# shared bucket (coarse, never bypassable) — it will NEVER trust a client-settable
# header. Values:
#   cf          → Cloudflare CF-Connecting-IP (use behind Cloudflare; demo.quantika.org)
#   xff-trusted → X-Forwarded-For at a trusted-hop offset; also set TRUSTED_PROXY_COUNT
#   xrealip     → X-Real-IP, ONLY if the proxy overwrites it (a bare reverse_proxy does not)
RATE_LIMIT_CLIENT_IP_SOURCE=cf
# Trusted appending proxy hops (only for xff-trusted mode), e.g. Caddy=1, CF+Caddy=2.
TRUSTED_PROXY_COUNT=2

# WhatsApp Business Cloud API (spec-alpha-04)
# Obtain from Meta Developer Console → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_app_secret_here

# Internal API token for server-to-server ingest endpoint (spec-alpha-10)
QUANTIKA_INTERNAL_TOKEN=your_internal_api_token_here

# Datalastic AIS provider (spec-beta-01, γ-VS Phase 1)
# Obtain from https://datalastic.com/api/ — Starter €99/mo (€9 trial 14 days)
# See docs/SERVICES-DEFERRED.md
DATALASTIC_API_KEY=

# OpenSanctions API (β-09 sanctions screening, γ-VS vessel-search filter)
# Free tier: register at https://www.opensanctions.org/api/
# See docs/SERVICES-DEFERRED.md
OPENSANCTIONS_API_KEY=

# Pipedrive CRM Bridge (spec-beta-02 — ARCHIVED, see SERVICES-DEFERRED.md)
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=http://localhost:3000/api/integrations/pipedrive/oauth
PIPEDRIVE_WEBHOOK_SECRET=
ENCRYPTION_KEY=  # 32-byte hex for AES-256-GCM refresh token encryption
PIPEDRIVE_API_DOMAIN=api.pipedrive.com  # optional, per-company domain (default: api.pipedrive.com)

# ── AI Provider Routing (Wave γ) ────────────────────────────────────────────────
# Global provider: "openai" (default, uses ClipProxy) | "gemini" | "bedrock"
AI_PROVIDER=openai
# Per-scope overrides (examples — uncomment and set to activate):
# CLASSIFY_PROVIDER=gemini
# MATCH_PROVIDER=bedrock
# PARSE_CARGO_PROVIDER=openai
# PARSE_VESSEL_PROVIDER=openai
# PARSE_RECAP_PROVIDER=openai
# PARSE_RECAP_MODEL=gemini-2.5-pro  # Heavy reasoning endpoint — Pro by default when provider=gemini
# RECAP_PROVIDER=openai
# DRAFT_QUOTE_PROVIDER — intentionally unset for the web process.
# The route no longer calls callAiText; it enqueues a job. Do NOT set
# DRAFT_QUOTE_PROVIDER=claude-cli for Next — the NEXT_RUNTIME guard at
# lib/ai-provider.ts:421 rejects it. CLI is invoked ONLY inside the
# standalone tsx worker (scripts/quote-workshop/worker.ts).
# DRAFT_QUOTE_PROVIDER=openai
# DRAFT_REPLY_PROVIDER=openai

# ── Draft-quote background workshop (claude-cli on founder subscription) ──────
# worker: scripts/quote-workshop/worker.ts (tsx script, NOT a Next handler)
# Model choice: claude-sonnet-4-6 = latency/quality balance for a quote email;
#   latency ~5-15 s but now a background job so less critical.
#   Use claude-opus-4-8 for higher-quality prose (~2-3x slower).
DRAFT_QUOTE_CLI_MODEL=claude-sonnet-4-6
# --max-budget-usd per call. Under subscription OAuth this is a SOFT spend
# estimate the CLI enforces internally; it does NOT bill a card — it guards
# against runaway loops. RAG-enriched prompts (~4-5 KB) need > 0.05 default.
DRAFT_QUOTE_CLI_BUDGET_USD=0.20
# Max queued jobs before 429 queue_full (per-process depth guard)
QUOTE_QUEUE_MAX_DEPTH=20
# processing jobs older than this ms are reaped to 'error' on worker start
QUOTE_JOB_TTL_MS=120000
# Shared secret for worker → /api/internal/quote-event localhost callback
# Generate: openssl rand -hex 32
INTERNAL_EVENT_TOKEN=
# Internal callback URL (must match the Next.js port; default 3000)
INTERNAL_EVENT_URL=http://127.0.0.1:3000/api/internal/quote-event
# WHATSAPP_OCR_PROVIDER=openai
# WHATSAPP_VOICE_PROVIDER=openai
# AGENT_PLANNER_PROVIDER=openai
# EXPLAIN_DEAL_PROVIDER=openai
NEXT_PUBLIC_EXPLAIN_DEAL_ENABLED=false

# Google Gemini via Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=/path/to/quantika-vertex-ai.json
GOOGLE_CLOUD_PROJECT=quantika-demo-2026
GOOGLE_CLOUD_LOCATION=us-central1
AI_MODEL_GEMINI_DEFAULT=gemini-2.5-flash
# Override Gemini model for parse-cargo scope (default: AI_MODEL_GEMINI_DEFAULT)
# PARSE_CARGO_GEMINI_MODEL=gemini-2.5-pro

# AWS Bedrock (for match endpoint, Anthropic Claude via Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Bedrock model selector (direct inference — no cross-region us./eu. prefix)
# - For Claude Opus 4.7 (most capable, expensive): anthropic.claude-opus-4-7
# - For Claude Sonnet 4.6 (good balance, 5x cheaper): anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=anthropic.claude-opus-4-7

# Per-scope override (Wave γ — match endpoint can use cheaper Sonnet):
# MATCH_MODEL=anthropic.claude-sonnet-4-6

# ── Knowledge Layer (Phase 1) ───────────────────────────────────────────────────
# Feature flag: use real OFAC+EU corpus from database instead of fixtures
# Default: false (rollback safety — uses sample-data/sanction-corpus fixtures)
KNOWLEDGE_SANCTIONS_REAL=false

# Feature flag: auto-resolve distanceNm from LOCODEs when missing in TCE API
# Default: false (require explicit distanceNm for backward compatibility)
# When true: POST /api/voyage/tce accepts requests without distanceNm if valid LOCODEs provided
KNOWLEDGE_LAYER_DISTANCES_ENABLED=false

# Feature flag: source war_risk premiums from knowledge_war_risk_zones table
# instead of in-memory JWC 2024-26 fixture. Default: false (rollback safety,
# uses existing fixture).
KNOWLEDGE_WAR_RISK_FROM_DB=false

# Feature flag: enable RAG retrieval (Phase 2 — vec0 + FTS5 hybrid search)
# imsbc_vec/imsbc_fts populated (116 chunks). igc/jwc/bimco: pending
# When false: retrieve() throws Error("RAG is not enabled")
KNOWLEDGE_RAG_ENABLED=true

# ── Wave γ Feature Flags ─────────────────────────────────────────────────────

# Feature flag: charterer credit tracker (γ-02)
# Default: false — charterer credit database and UI disabled
# When true: enables charterer credit rating UI, payment history tracking, L/C requirement flag
# Server: CHARTERER_CREDIT_ENABLED; Client: NEXT_PUBLIC_CHARTERER_CREDIT_ENABLED
CHARTERER_CREDIT_ENABLED=false
NEXT_PUBLIC_CHARTERER_CREDIT_ENABLED=false

# Feature flag: multi-currency display in voyage-tce form (γ-01)
# Default: false — voyage TCE form shows USD only, no UI change in prod
# When true: currency dropdown (USD/EUR/GBP/NOK/AED) appears in EconomicsTab
#   showing "1 USD ≈ X [currency]" fallback rate badge for non-USD selection.
# Note: MULTI_CURRENCY_V2_ENABLED is server-side only (not public).
#   NEXT_PUBLIC_MULTI_CURRENCY_V2_ENABLED controls client-side UI rendering.
# Daily fx_rates cron (scripts/knowledge/cron/refresh-fx-rates.ts) runs
#   independently of this flag — schedule in crontab separately.
MULTI_CURRENCY_V2_ENABLED=false
NEXT_PUBLIC_MULTI_CURRENCY_V2_ENABLED=false

# Feature flag: FuelEU Maritime penalty cost line (audit A.5)
# Default: false — no FuelEU cost in voyage economics, behavior identical to legacy
# When true: FuelEU penalty cost line in voyage P&L (compute-tce) + tile in EconomicsTab.
#   Penalty €2400/tCO2eq over the Reg. 2023/1805 GHG intensity target; scope rule:
#   100% energy intra-EU, 50% when one voyage endpoint is EU (same originEu/destEu
#   detection as EU ETS). UI is data-driven (breakdown.fueleu_usd) — no client env read.
FUELEU_ENABLED=false
NEXT_PUBLIC_FUELEU_ENABLED=false

# Feature flag: Market benchmark full dashboard (γ-04)
# Default: false — market index dashboard and API disabled
# When true: Enables GET /api/market/indices and /market dashboard page
#   showing BHSI (Baltic Handysize), TMI (TransAtlantic), Drewry breakbulk indices
# MARKET_BENCHMARK_FULL_ENABLED — server-side flag, pair with NEXT_PUBLIC_MARKET_BENCHMARK_FULL_ENABLED
#   Both must be set to true together for the /market page to load data correctly.
#   Server flag controls the API route; client flag controls the UI rendering.
MARKET_BENCHMARK_FULL_ENABLED=false
NEXT_PUBLIC_MARKET_BENCHMARK_FULL_ENABLED=false

# Feature flag: PSC detention history (γ-03)
# Default: false — PSC detention history API and UI disabled
# When true: Enables GET /api/vessels/[imo]/psc-history endpoint and
#   /vessels/[imo]/psc-history page showing Paris MoU/Tokyo MoU/USCG inspections
PSC_DETENTION_ENABLED=false
NEXT_PUBLIC_PSC_DETENTION_ENABLED=false
PSC_API_BASE_URL=

# Feature flag: Laytime Engine (γ-05)
# Default: false — laytime calculator API and UI disabled
# When true: Enables POST /api/laytime/calculate and /laytime page
#   with SHEX/SHINC/FHEX/FHINC mode support, weather delays, holiday exclusions
LAYTIME_ENGINE_ENABLED=false
NEXT_PUBLIC_LAYTIME_ENGINE_ENABLED=false

# Feature flag: BIMCO RAG charter party clauses (γ-09)
# Default: false — BIMCO clauses search disabled
# When true: Enables GET /api/knowledge/clauses and /clauses page
#   for searching GENCON 2022, HEAVYCON, PROJECTCON clauses via FTS5
# Sync script: npx tsx scripts/knowledge/cron/refresh-bimco-rag.ts
BIMCO_RAG_ENABLED=false
NEXT_PUBLIC_BIMCO_RAG_ENABLED=false

# Admin endpoints authentication (FINDING-001 — knowledge layer admin auth)
# Secret token for /api/admin/knowledge-status and /api/admin/knowledge/refresh
# Sent by client as X-Admin-Token request header.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=your_admin_token_here

# Cron heartbeat authentication (C7 — daily sanctions refresh)
# Secret token for /api/admin/cron-heartbeat endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_token_here

# Searoute microservice URL (D4 — port distance calculations)
# Default: http://127.0.0.1:8200 (local Python service)
SEAROUTE_SERVICE_URL=http://127.0.0.1:8200

# EU Consolidated Sanctions API token (C5 — optional, for token rotation)
# Default: empty (public endpoint, token may be required in future)
EU_SANCTIONS_TOKEN=

# Cron heartbeat webhook URL (used by backup.sh + refresh-sanctions cron)
# Keep as localhost — Cloudflare strips X-Cron-Secret on public APP_URL requests.
# Default: http://localhost:3000/api/admin/cron-heartbeat
HEARTBEAT_URL=http://localhost:3000/api/admin/cron-heartbeat

# JWC bulletin scraper source URL (Phase 2 RAG — spec-17)
# Default: https://www.lmalloyds.com/lma/jointwar (official LMA/Lloyd's JWC page)
# Used by lib/knowledge/sources/jwc/scraper.ts for bulletin listing
JWC_SOURCE_URL=https://www.lmalloyds.com/lma/jointwar

# ── Demo Auth (private corpus access) ───────────────────────────────────────────
# Enable to require basic-auth login for entire demo.quantika.org.
# Set false in dev for fast iteration (no login gate).
DEMO_AUTH_ENABLED=true
DEMO_AUTH_USER=admin
# Set actual password in .env.local (gitignored). 24+ random chars recommended for prod.
DEMO_AUTH_PASSWORD=change_me_in_env_local
# Generate via: openssl rand -hex 32
DEMO_AUTH_SECRET=change_me_to_32_byte_hex
DEMO_AUTH_COOKIE_DAYS=30

# ── Sea-route distance tiers (B5a/B5b) ─────────────────────────────────────
# Tier 2: pre-populated searoute JSON (~106k pairs, exact sea routes via canals)
# Set false to skip JSON lookup and fall through to haversine. Default: true.
DISTANCE_USE_SEAROUTE_JSON=true

# Tier 3: on-the-fly searoute (searoute-ts, canal/strait-aware) for pairs not in
# the hand-curated matrix or pre-populated JSON. Set false to skip and fall
# through directly to haversine. Requires Node runtime (not Edge-compatible).
# Default: true.
DISTANCE_USE_SEAROUTE_LIVE=true
