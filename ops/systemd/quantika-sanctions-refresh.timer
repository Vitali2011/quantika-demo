[Unit]
Description=Quantika Daily Sanctions Refresh Timer
Requires=quantika-sanctions-refresh.service

[Timer]
# Run daily at 03:30 UTC (off-peak hours)
OnCalendar=*-*-* 03:30:00

# Add randomized delay of 0-30 minutes to avoid thundering herd
# if multiple instances are deployed
RandomizedDelaySec=1800

# Ensure timer persists across reboots
Persistent=true

[Install]
WantedBy=timers.target
