[Unit]
Description=Quantika Daily Sanctions Refresh (OFAC + EU)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantika
Group=quantika
WorkingDirectory=/opt/quantika/app
Environment="NODE_ENV=production"
EnvironmentFile=/opt/quantika/app/.env
ExecStart=/usr/bin/npx tsx scripts/knowledge/cron/refresh-sanctions.ts
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantika-sanctions

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/quantika/app/data

[Install]
WantedBy=multi-user.target
