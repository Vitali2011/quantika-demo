[Unit]
Description=Quantika OFAC+EU sanctions refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantika
Group=quantika
WorkingDirectory=/opt/quantika
ExecStart=/usr/bin/node /opt/quantika/scripts/knowledge/cron/refresh-sanctions.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantika-sanctions
TimeoutStartSec=30min
EnvironmentFile=/opt/quantika/.env.production

# Failure notification — rely on Sentry SDK in refresh-sanctions.js (already in stack)

[Install]
WantedBy=multi-user.target
