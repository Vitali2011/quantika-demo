[Unit]
Description=Quantika bunker price daily refresh (USDA → Ship&Bunker → OilMonster)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/quantika-demo
ExecStart=/usr/bin/npx tsx --env-file=.env.local scripts/knowledge/cron/refresh-bunker.ts
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantika-bunker
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
