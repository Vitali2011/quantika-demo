{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "VALIDATION_CLIENT=cli USE_SYSTEM_CLAUDE=true npx tdd-guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "VALIDATION_CLIENT=cli USE_SYSTEM_CLAUDE=true npx tdd-guard"
          }
        ]
      }
    ]
  }
}
