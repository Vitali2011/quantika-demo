# Staging environment template — copy to .env.local for staging deployment
# All credential values are placeholders — no production/staging secrets here

# === OAuth (Google) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AI Proxy (ClipProxy) ===
CLIPROXY_API_KEY=
CLIPROXY_BASE_URL=

# === AI Models ===
AI_MODEL_HEAVY=
AI_MODEL_LIGHT=

# === App ===
NODE_ENV=staging
PORT=3001
NEXT_PUBLIC_APP_URL=https://staging.quantika.org

# === Observability (Sentry) ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# === Observability (PostHog) ===
NEXT_PUBLIC_POSTHOG_KEY=
